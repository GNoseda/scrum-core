# =============================================================================
# LLM Configuration
# =============================================================================

# Which LLM provider to use. Options: "openai", "stub" (default: "stub")
# Use "stub" in development/test to avoid real API calls.
LLM_PROVIDER=stub

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Database
# =============================================================================

# PostgreSQL password for the development/test database user (scrum_core).
# Only needed if your local Postgres requires a password.
SCRUM_CORE_DATABASE_PASSWORD=

# =============================================================================
# Rails / Puma
# =============================================================================

# Number of threads per Puma worker (default: 3)
RAILS_MAX_THREADS=3

# Port to bind Puma to (default: 3000)
PORT=3000

# Log level for production (default: info)
# Options: debug, info, warn, error, fatal
RAILS_LOG_LEVEL=info

# =============================================================================
# Background Jobs (Solid Queue)
# =============================================================================

# Set to "true" to run Solid Queue inside the Puma process (default: off)
SOLID_QUEUE_IN_PUMA=

# Number of job worker processes (default: 1)
JOB_CONCURRENCY=1

# =============================================================================
# CI
# =============================================================================

# Set to any truthy value in CI environments to enable eager loading during tests
CI=
